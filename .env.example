SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
ANTHROPIC_API_KEY=
PORT=
NODE_ENV=
SENTRY_DSN=

# 상담 데스크 ↔ 고객앱 연동 키 (앱 서버가 x-desk-app-key 헤더로 보낸다)
# 미설정 시: 운영(NODE_ENV=production)은 /api/desk/app/* 를 503 으로 차단(서버는 정상 부팅),
#            개발·스테이징은 무인증 통과 + warn. 앱팀 연동 전 반드시 발급·설정할 것
DESK_APP_KEY=
# 앱 연동 rate limit (분당, 키 기준). 기본 3000
DESK_APP_RATE_PER_MIN=3000
